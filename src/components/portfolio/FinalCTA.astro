---
import { COPY } from "../../data/copy";
import Icon from "./Icon.astro";

const fr = COPY.fr.final;
const en = COPY.en.final;
const ui = COPY.fr.ui;
---

<section id="contact" class="section">
  <div class="container-pf" style="display:flex;flex-direction:column;align-items:center;gap:32px">
    <div class="glass" style="max-width:640px;width:100%;padding:56px 40px;text-align:center">
      <div
        style="width:64px;height:64px;border-radius:50%;margin:0 auto 22px;overflow:hidden;box-shadow:0 0 24px rgba(61,224,255,0.3), 0 0 0 1px rgba(255,255,255,0.1)"
      >
        <img
          src="/avatar.png"
          alt="Pierre-Antoine Andriès"
          style="width:100%;height:100%;object-fit:cover;display:block"
        />
      </div>

      <div class="eyebrow">
        <span class="i18n-fr">{fr.eyebrow}</span><span class="i18n-en">{en.eyebrow}</span>
      </div>

      <h2 class="display" style="font-size:clamp(36px,5vw,56px);text-wrap:balance">
        <span style="display:block">
          <span class="i18n-fr">{fr.h2a}</span><span class="i18n-en">{en.h2a}</span>
        </span>
        <span class="text-grad-cyan" style="display:block">
          <span class="i18n-fr">{fr.h2b}</span><span class="i18n-en">{en.h2b}</span>
        </span>
      </h2>

      <p
        style="margin-top:18px;color:var(--text2);font-size:15px;line-height:1.55;max-width:440px;margin-left:auto;margin-right:auto"
      >
        <span class="i18n-fr">{fr.desc}</span><span class="i18n-en">{en.desc}</span>
      </p>

      <a
        href="mailto:pierreantoineandries@gmail.com"
        class="pill cta-cyan"
        style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;margin-top:28px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.22em"
      >
        <span class="i18n-fr">{fr.cta}</span><span class="i18n-en">{en.cta}</span>
        <Icon name="arrowR" size={16} />
      </a>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:28px;justify-content:center;margin-top:8px">
      <a
        href="mailto:pierreantoineandries@gmail.com"
        class="mono"
        style="font-size:13px;letter-spacing:0.18em;color:var(--text2);display:flex;gap:12px;align-items:center"
      >
        <Icon name="mail" size={20} />EMAIL
      </a>
      <a
        href="https://www.linkedin.com/in/pa-andries"
        target="_blank"
        rel="noopener"
        class="mono"
        style="font-size:13px;letter-spacing:0.18em;color:var(--text2);display:flex;gap:12px;align-items:center"
      >
        <Icon name="in" size={20} />LINKEDIN
      </a>
      <a
        href="https://github.com/PA-Andries"
        target="_blank"
        rel="noopener"
        class="mono"
        style="font-size:13px;letter-spacing:0.18em;color:var(--text2);display:flex;gap:12px;align-items:center"
      >
        <Icon name="gh" size={20} />GITHUB
      </a>
      <a
        href="tel:+33769017623"
        class="mono"
        style="font-size:13px;letter-spacing:0.16em;color:var(--text2);display:flex;gap:12px;align-items:center"
      >
        <Icon name="phone" size={20} />+33 7 69 01 76 23
      </a>
      <a
        href="/cv/CV-PA-Andries.pdf"
        target="_blank"
        rel="noopener"
        class="mono"
        style="font-size:13px;letter-spacing:0.18em;color:var(--orange);display:flex;gap:12px;align-items:center"
      >
        <Icon name="file" size={20} />CV PDF
      </a>
    </div>

    <div class="mono" style="font-size:11px;letter-spacing:0.18em;color:var(--text2);text-align:center;margin-top:16px">
      <span class="i18n-fr">{ui.footer}</span><span class="i18n-en">{COPY.en.ui.footer}</span>
    </div>
  </div>
</section>
