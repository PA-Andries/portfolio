---
import { COPY } from "../../data/copy";
import Icon from "./Icon.astro";

const fr = COPY.fr.projects;
const en = COPY.en.projects;
---

<section id="projets" class="section">
  <div class="container-pf">
    <div class="glass" style="padding:56px 40px">
      <div class="eyebrow">
        <span class="i18n-fr">{fr.eyebrow}</span><span class="i18n-en">{en.eyebrow}</span>
      </div>

      <h2 class="display h2-pf" style="text-wrap:balance">
        <span style="display:block">
          <span class="i18n-fr">{fr.h2a}</span><span class="i18n-en">{en.h2a}</span>
        </span>
        <span class="text-grad-cyan" style="display:block">
          <span class="i18n-fr">{fr.h2b}</span><span class="i18n-en">{en.h2b}</span>
        </span>
      </h2>

      <p style="margin-top:18px;color:var(--text2);font-size:16px;max-width:680px">
        <span class="i18n-fr">{fr.desc}</span><span class="i18n-en">{en.desc}</span>
      </p>

      {/* Featured project — Thalès × IMT Antibrouillage radar mmW. Full-width hero card. */}
      <div class="pcard pcard-featured" style="margin-top:36px;padding:40px;border:1px solid rgba(61,224,255,0.25);background:linear-gradient(135deg, rgba(15,30,55,0.7), rgba(10,14,26,0.6))">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <div class="ico">
            <Icon name={fr.cards[0].icon as any} />
          </div>
          <div class="mono" style="font-size:12px;letter-spacing:0.22em">
            <span style="color:var(--orange);letter-spacing:0.28em" class="i18n-fr">PROJET PHARE</span><span style="color:var(--orange);letter-spacing:0.28em" class="i18n-en">FEATURED PROJECT</span>
            <span style="color:var(--dim);margin:0 10px">·</span>
            <span style="color:var(--text2)">{fr.cards[0].meta}</span>
          </div>
        </div>
        <h3 class="display" style="font-size:clamp(28px, 4vw, 40px);margin-top:20px;line-height:1.02;text-wrap:balance">
          <span class="i18n-fr">{fr.cards[0].title}</span><span class="i18n-en">{en.cards[0].title}</span>
        </h3>
        <p style="margin-top:18px;color:var(--text2);font-size:16px;line-height:1.6;max-width:780px">
          <span class="i18n-fr">{fr.cards[0].desc}</span><span class="i18n-en">{en.cards[0].desc}</span>
        </p>
        <div style="margin-top:20px">
          <span class="i18n-fr">
            {fr.cards[0].tags.map((tg) => <span class="chip">{tg}</span>)}
          </span>
          <span class="i18n-en">
            {en.cards[0].tags.map((tg) => <span class="chip">{tg}</span>)}
          </span>
        </div>
      </div>

      {/* Remaining projects in 2-column grid */}
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px;margin-top:18px">
        {
          fr.cards.slice(1).map((c, idx) => {
            const i = idx + 1;
            // Aucun projet n'est "en cours" aujourd'hui — le badge reste câblé pour les prochains.
            const isLive = (c as { live?: boolean }).live === true;
            return (
              <div class={`pcard ${c.color === "orange" ? "orange" : ""}`}>
                {isLive && (
                  <span class="badge-live">
                    <span class="i18n-fr">{COPY.fr.ui.live}</span><span class="i18n-en">{COPY.en.ui.live}</span>
                  </span>
                )}
                <div style={`display:flex;align-items:center;gap:14px${isLive ? ";padding-right:148px" : ""}`}>
                  <div class="ico">
                    <Icon name={c.icon as any} />
                  </div>
                  <div class="mono" style="color:var(--text2);font-size:11px;letter-spacing:0.16em">{c.meta}</div>
                </div>
                <h3 class="display" style="font-size:24px;margin-top:18px;line-height:1.05;text-wrap:balance">
                  <span class="i18n-fr">{c.title}</span><span class="i18n-en">{en.cards[i].title}</span>
                </h3>
                <p style="margin-top:14px;color:var(--text2);font-size:14px;line-height:1.55">
                  <span class="i18n-fr">{c.desc}</span><span class="i18n-en">{en.cards[i].desc}</span>
                </p>
                <div style="margin-top:16px">
                  <span class="i18n-fr">
                    {c.tags.map((tg) => <span class="chip">{tg}</span>)}
                  </span>
                  <span class="i18n-en">
                    {en.cards[i].tags.map((tg) => <span class="chip">{tg}</span>)}
                  </span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
