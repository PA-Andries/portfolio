---
// AERO backdrop — single variant ported from Claude Design.
// Parallax driven by portfolio.ts which sets CSS variables based on scrollY.
---

<div class="backdrop-stage" aria-hidden="true" data-backdrop>
  <div class="backdrop-layer bd-aero" style="opacity: 1;">
    <div class="stars" data-bd-layer="slow"></div>
    <div class="grid-floor" data-bd-layer="grid"></div>
    <div class="radar-sweep" data-bd-layer="radar"></div>
    <div class="horizon" data-bd-layer="med"></div>
  </div>
  <div class="backdrop-vignette"></div>
</div>
