---
import { COPY } from "../../data/copy";
import Icon from "./Icon.astro";

const fr = COPY.fr.nav;
const en = COPY.en.nav;
---

<nav class="nav-pill">
  <a href="#home" class="logo" aria-label="Home"><span>PA</span></a>

  <div class="links">
    <a href="#home"><span class="i18n-fr">{fr.home}</span><span class="i18n-en">{en.home}</span></a>
    <a href="#about"><span class="i18n-fr">{fr.about}</span><span class="i18n-en">{en.about}</span></a>
    <a href="#projets"><span class="i18n-fr">{fr.projects}</span><span class="i18n-en">{en.projects}</span></a>
    <a href="#parcours"><span class="i18n-fr">{fr.parcours}</span><span class="i18n-en">{en.parcours}</span></a>
    <a href="#contact"><span class="i18n-fr">{fr.contact}</span><span class="i18n-en">{en.contact}</span></a>
  </div>

  <div class="lang-toggle" data-lang-toggle>
    <button data-lang-set="fr" class="on">FR</button>
    <button data-lang-set="en">EN</button>
  </div>

  <a
    href="/cv/CV-PA-Andries.pdf"
    target="_blank"
    rel="noopener"
    class="pill cta-cyan"
    style="padding:8px 16px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.2em;display:flex;align-items:center;gap:6px"
  >
    <span class="i18n-fr">{fr.cv}</span><span class="i18n-en">{en.cv}</span>
    <Icon name="arrowD" size={14} />
  </a>
</nav>
