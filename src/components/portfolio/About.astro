---
import { COPY } from "../../data/copy";

const fr = COPY.fr.about;
const en = COPY.en.about;

const techs = [
  "PYTHON",
  "MATLAB",
  "PYTORCH",
  "ROBERTA",
  "BART",
  "T5",
  "LIME",
  "NLP",
  "FASTAPI",
  "SQL",
  "GIT",
  "JIRA",
  "HADOOP",
  "SPARK",
  "PYSPARK",
  "C++",
  "MESHROOM",
  "POTREE",
  "REACT",
  "ARDUINO",
  "LATEX",
  "LINUX",
];
---

<section id="about" class="section">
  <div class="container-pf">
    <div class="glass" style="padding:64px 48px">
      <div class="eyebrow">
        <span class="i18n-fr">{fr.eyebrow}</span><span class="i18n-en">{en.eyebrow}</span>
      </div>

      <h2 class="display h2-pf" style="text-wrap:balance">
        {/* Tricolore lettré : Q bleu · U blanc (avec glow pour la lisibilité) · I rouge. Marche aussi pour W/H/O en EN. */}
        <span style="display:block">
          <span class="i18n-fr">
            <span style="color:#0055A4">Q</span><span style="color:#ffffff;text-shadow:0 0 14px rgba(255,255,255,0.45)">U</span><span style="color:#EF4135">I</span>
          </span>
          <span class="i18n-en">
            <span style="color:#0055A4">W</span><span style="color:#ffffff;text-shadow:0 0 14px rgba(255,255,255,0.45)">H</span><span style="color:#EF4135">O</span>
          </span>
        </span>
        <span class="text-grad-cyan" style="display:block">
          <span class="i18n-fr">{fr.h2b}</span><span class="i18n-en">{en.h2b}</span>
        </span>
      </h2>

      <p style="margin-top:24px;color:var(--text2);font-size:17px;line-height:1.6;max-width:920px">
        <span class="i18n-fr">{fr.desc}</span><span class="i18n-en">{en.desc}</span>
      </p>
    </div>

    <div
      style="margin-top:30px;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)"
    >
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <div style="display:flex">
              {techs.map((tk) => (
                <span class="marquee-item">
                  {tk}
                  <span class="bullet" style="margin-left:36px">·</span>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
