---
import { COPY } from "../../data/copy";

const fr = COPY.fr.about;
const en = COPY.en.about;

const techs = [
  "PYTHON",
  "MATLAB",
  "PYTORCH",
  "NLP",
  "FASTAPI",
  "SQL",
  "GIT",
  "HADOOP",
  "SPARK",
  "ARDUINO",
  "LATEX",
  "LINUX",
];
---

<section id="about" class="section">
  <div class="container-pf">
    <div class="glass" style="padding:64px 48px">
      <div class="eyebrow">
        <span class="i18n-fr">{fr.eyebrow}</span><span class="i18n-en">{en.eyebrow}</span>
      </div>

      <h2 class="display h2-pf" style="text-wrap:balance">
        <span style="display:block">
          <span class="i18n-fr">{fr.h2a}</span><span class="i18n-en">{en.h2a}</span>
        </span>
        <span class="text-grad-cyan" style="display:block">
          <span class="i18n-fr">{fr.h2b}</span><span class="i18n-en">{en.h2b}</span>
        </span>
      </h2>

      <p style="margin-top:24px;color:var(--text2);font-size:17px;line-height:1.6;max-width:760px">
        <span class="i18n-fr">{fr.desc}</span><span class="i18n-en">{en.desc}</span>
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:36px">
        {
          fr.stats.map((s, i) => (
            <div
              class="stat"
              style={`color: ${s.c === "cyan" ? "var(--cyan)" : "var(--orange)"}`}
            >
              <div class="num">{s.n}</div>
              <div class="lbl">
                <span class="i18n-fr">{s.l}</span><span class="i18n-en">{en.stats[i].l}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      style="margin-top:30px;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)"
    >
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <div style="display:flex">
              {techs.map((tk) => (
                <span class="marquee-item">
                  {tk}
                  <span class="bullet" style="margin-left:36px">·</span>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
