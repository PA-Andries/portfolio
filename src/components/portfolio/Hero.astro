---
import { COPY } from "../../data/copy";
import Icon from "./Icon.astro";

const fr = COPY.fr.hero;
const en = COPY.en.hero;
---

<section id="home" class="section">
  <div class="container-pf" style="display:flex;flex-direction:column;align-items:center;gap:36px">
    <div class="glass" style="max-width:1120px;width:100%;padding:64px 56px;text-align:center">
      <span
        class="pill mono"
        style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid rgba(255,139,61,0.35);background:rgba(255,139,61,0.08);color:var(--orange);font-size:10px"
      >
        <span style="width:6px;height:6px;border-radius:50%;background:var(--orange);box-shadow:0 0 8px var(--orange)"></span>
        <span class="i18n-fr">{fr.badge}</span><span class="i18n-en">{en.badge}</span>
      </span>

      <h1 class="display h1-pf" style="margin-top:24px;text-wrap:balance">
        <span style="display:block">
          <span class="i18n-fr">{fr.h1a}</span><span class="i18n-en">{en.h1a}</span>
        </span>
        <span class="text-grad-cyan hero-subtitle" style="display:block;font-size:clamp(20px,3.2vw,42px);letter-spacing:0.02em;margin-top:10px">
          <span class="i18n-fr">{fr.h1b}</span><span class="i18n-en">{en.h1b}</span>
        </span>
      </h1>

      <p
        style="margin-top:22px;color:var(--text2);font-size:16px;line-height:1.55;max-width:640px;margin-left:auto;margin-right:auto"
      >
        <span class="i18n-fr">
          {fr.sub[0]}<strong style="color:#fff">{fr.sub[1]}</strong>{fr.sub[2]}<span style="color:var(--orange);font-weight:600">{fr.sub[3]}</span>{fr.sub[4]}
        </span>
        <span class="i18n-en">
          {en.sub[0]}<strong style="color:#fff">{en.sub[1]}</strong>{en.sub[2]}<span style="color:var(--orange);font-weight:600">{en.sub[3]}</span>{en.sub[4]}
        </span>
      </p>

      <div style="display:flex;justify-content:center;gap:12px;margin-top:32px;flex-wrap:wrap">
        <a
          href="#projets"
          class="pill cta-cyan"
          style="padding:14px 22px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.22em;display:inline-flex;align-items:center;gap:10px"
        >
          <span class="i18n-fr">{fr.cta1}</span><span class="i18n-en">{en.cta1}</span>
          <Icon name="arrowR" size={16} />
        </a>
        <a
          href="#about"
          class="pill cta-dark"
          style="padding:14px 22px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.22em;display:inline-flex;align-items:center;gap:10px"
        >
          <span class="i18n-fr">{fr.cta2}</span><span class="i18n-en">{en.cta2}</span>
          <Icon name="arrowD" size={16} />
        </a>
      </div>
    </div>

    <div class="glass" style="padding:24px 36px;display:flex;gap:40px;flex-wrap:wrap;justify-content:center">
      <div style="text-align:center;min-width:180px">
        <div class="mono" style="color:var(--cyan);font-size:13px;letter-spacing:0.22em">
          <span class="i18n-fr">{fr.stat1l}</span><span class="i18n-en">{en.stat1l}</span>
        </div>
        <div class="mono" style="color:var(--text2);font-size:11px;margin-top:6px;letter-spacing:0.16em">
          <span class="i18n-fr">{fr.stat1s}</span><span class="i18n-en">{en.stat1s}</span>
        </div>
      </div>
      <div style="text-align:center;min-width:180px">
        <div class="mono" style="color:var(--cyan);font-size:13px;letter-spacing:0.22em">
          <span class="i18n-fr">{fr.stat2l}</span><span class="i18n-en">{en.stat2l}</span>
        </div>
        <div class="mono" style="color:var(--text2);font-size:11px;margin-top:6px;letter-spacing:0.16em">
          <span class="i18n-fr">{fr.stat2s}</span><span class="i18n-en">{en.stat2s}</span>
        </div>
      </div>
      <div style="text-align:center;min-width:180px">
        <div class="mono" style="color:var(--orange);font-size:13px;letter-spacing:0.22em">
          <span class="i18n-fr">{fr.stat3l}</span><span class="i18n-en">{en.stat3l}</span>
        </div>
        <div class="mono" style="color:var(--text2);font-size:11px;margin-top:6px;letter-spacing:0.16em">
          <span class="i18n-fr">{fr.stat3s}</span><span class="i18n-en">{en.stat3s}</span>
        </div>
      </div>
    </div>
  </div>
</section>
