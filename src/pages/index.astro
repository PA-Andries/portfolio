---
import BaseLayout from "../layouts/BaseLayout.astro";
import Backdrop from "../components/portfolio/Backdrop.astro";
import NavPill from "../components/portfolio/NavPill.astro";
import Hero from "../components/portfolio/Hero.astro";
import About from "../components/portfolio/About.astro";
import Projects from "../components/portfolio/Projects.astro";
import Parcours from "../components/portfolio/Parcours.astro";
import Extra from "../components/portfolio/Extra.astro";
import FinalCTA from "../components/portfolio/FinalCTA.astro";
import SectionIndicator from "../components/portfolio/SectionIndicator.astro";
import Terminal from "../components/portfolio/Terminal.astro";
---

<BaseLayout>
  <Backdrop />
  <NavPill />

  <main>
    <Hero />
    <About />
    <Projects />
    <Parcours />
    <Extra />
    <FinalCTA />
  </main>

  <SectionIndicator />
  <Terminal />

  <div class="grain"></div>
</BaseLayout>

<script>
  import "../scripts/portfolio";
</script>
